__pycache__/
*.pyc
.pytest_cache/
*.pt
*.pth
*.pkl
# Build/archive artifacts (e.g. ContextLens.zip) — never commit
*.zip
models/
outputs/
data/

# Runtime learned-memory state (cross-video brand + Tier-4 product co-occurrence)
# — regenerable per environment, must never be committed as source.
config/brand_memory.json
config/product_resolutions.json

# Secrets — never commit API keys
.env
.env.*
!.env.example
LOGO_DEV_SECRET_KEY
LOGO_DEV_PUBLISHABLE_TOKEN

# Benchmark datasets (large, downloaded at runtime)
# Keep only the small results JSONs tracked for auditability; ignore the
# reference-logo bank and any dataset parquet files.
benchmark/*
!benchmark/results/
benchmark/results/*
!benchmark/results/*.json
# realvideo_v1: the durable record (manifest/splits/README/labels) is tracked;
# source videos and sampled frames stay ignored (gitignored benchmark/* is how
# video_labelled was lost — see realvideo_v1/README.md for the backup rule).
!benchmark/realvideo_v1/
benchmark/realvideo_v1/*
!benchmark/realvideo_v1/MANIFEST.sha256
!benchmark/realvideo_v1/splits.json
!benchmark/realvideo_v1/README.md
!benchmark/realvideo_v1/labels.jsonl
!benchmark/realvideo_v1/labels.proposals.json
!benchmark/realvideo_v1/export/
benchmark/realvideo_v1/export/*
!benchmark/realvideo_v1/export/report.json
!benchmark/realvideo_v1/export/logo_free.json
!benchmark/realvideo_v1/export/model_prelabelled.json
!benchmark/realvideo_v1/export/data.yaml
!benchmark/realvideo_v1/export/labels/
benchmark/realvideo_v1/export/labels/*
!benchmark/realvideo_v1/export/labels/**/*.txt

# Open-set candidate crops (runtime evidence images, regenerated per run)
static/openset_crops/

# Ad-hoc probe render output (scratch dir, same as fusion_eval/out/)
fusion_eval/out_probe/

# Python coverage artifacts
.coverage
htmlcov/

# Phase 3 SQLite job store (runtime data)
var/

# Downloaded model weights (fetched by scripts/download_models.py / HF cache)
weights/

# Editor and OS junk
.DS_Store
*.bak

# Node plugin deps (opencode ponytail)
node_modules/

# opencode/ponytail agent tooling (not part of the app)
opencode.json
package.json
package-lock.json
