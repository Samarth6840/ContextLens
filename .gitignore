__pycache__/
*.pyc
.pytest_cache/
*.pt
*.pth
*.pkl
# Build/archive artifacts (e.g. ContextLens.zip) — never commit
*.zip
models/
outputs/
data/

# Runtime learned-memory state (cross-video brand + Tier-4 product co-occurrence)
# — regenerable per environment, must never be committed as source.
config/brand_memory.json
config/product_resolutions.json

# Secrets — never commit API keys
.env
.env.*
!.env.example
LOGO_DEV_SECRET_KEY
LOGO_DEV_PUBLISHABLE_TOKEN

# Benchmark datasets (large, downloaded at runtime)
# Keep only the small results JSONs tracked for auditability; ignore the
# reference-logo bank and any dataset parquet files.
benchmark/*
!benchmark/results/
benchmark/results/*
!benchmark/results/*.json

# Open-set candidate crops (runtime evidence images, regenerated per run)
static/openset_crops/

# Python coverage artifacts
.coverage
htmlcov/

# Phase 3 SQLite job store (runtime data)
var/

# Node plugin deps (opencode ponytail)
node_modules/

# opencode/ponytail agent tooling (not part of the app)
opencode.json
package.json
package-lock.json
