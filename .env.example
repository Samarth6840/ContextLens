# Copy to .env and fill in your own keys. NEVER commit .env.
# Get keys at https://logo.dev
LOGO_DEV_SECRET_KEY=
LOGO_DEV_PUBLISHABLE_TOKEN=

# Free.ai API — OCR, STT, Vision, Embeddings (all-in-one)
# Get key at https://free.ai/signup/ (30K free tokens/day, no card)
FREE_AI_API_KEY=

# Phase 3 SaaS dashboard auth (optional — see config.yaml auth section)
CONTEXTLENS_ADMIN_USER=admin
CONTEXTLENS_ADMIN_PASSWORD=
# SQLite job store path (defaults to var/contextlens.db)
CONTEXTLENS_DB_PATH=

# Open-set reverse-image search: free Google Gemini backend (gemini_grounded)
# Get a free key at https://aistudio.google.com/apikey (no card required).
# Falls back to ~/.gemini_key if unset. Optional model override below
# (default gemini-2.5-flash; gemini-2.0-flash was shut down 2026-06-01).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
